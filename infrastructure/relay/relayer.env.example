# Relayer environment (systemd reads only this file). Holds a provider token: chmod 600.
BRIDGE_NETWORK=preprod
BRIDGE_STATE_DIR=/var/lib/bridge
BLOCKFROST_PROJECT_ID=nightpreprod...
# The funded Midnight wallet that pays claim fees (DUST), owner-only.
MIDNIGHT_SEED_FILE=/var/lib/bridge/midnight-test-wallet.json
# Claims are proven locally before submission.
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:16300
