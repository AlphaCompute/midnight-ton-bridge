{
  "name": "@alphaton/midnight-ton-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build-support.mjs check && tsc -p tsconfig.build.json && node scripts/build-support.mjs copy",
    "typecheck": "tsc",
    "test": "node scripts/build-support.mjs check && node --import tsx --test --test-force-exit tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "compile:ton": "tsx --env-file-if-exists=.env scripts/compile-ton.ts",
    "compile:midnight": "bash scripts/compile-midnight.sh",
    "prepare:testnet": "tsx --env-file-if-exists=.env scripts/prepare-testnet.ts",
    "fund:ton": "tsx --env-file-if-exists=.env scripts/fund-ton.ts",
    "wallet:sync": "tsx --env-file-if-exists=.env scripts/midnight-wallet.ts sync",
    "bootstrap:wallet": "tsx --env-file-if-exists=.env scripts/bootstrap-fresh-wallet.ts",
    "deploy:midnight": "tsx --env-file-if-exists=.env scripts/deploy-midnight.ts",
    "deploy:ton": "tsx --env-file-if-exists=.env scripts/deploy-ton.ts",
    "verify:ton": "tsx --env-file-if-exists=.env scripts/verify-ton.ts",
    "demo:local": "tsx --env-file-if-exists=.env scripts/demo-local.ts",
    "demo:testnet": "tsx --env-file-if-exists=.env scripts/demo-testnet.ts",
    "demo:unrecorded": "tsx --env-file-if-exists=.env scripts/demo-unrecorded.ts",
    "verify:local": "tsx --env-file-if-exists=.env scripts/verify-local.ts",
    "verify:testnet": "tsx --env-file-if-exists=.env scripts/verify-testnet.ts",
    "check:route": "tsx --env-file-if-exists=.env scripts/check-route.ts",
    "reconcile:midnight": "tsx --env-file-if-exists=.env scripts/midnight-wallet.ts reconcile",
    "reconcile:ton": "tsx --env-file-if-exists=.env scripts/reconcile-ton.ts",
    "operator": "tsx --env-file-if-exists=.env scripts/operator.ts",
    "relay": "tsx --env-file-if-exists=.env scripts/relay.ts",
    "app": "tsx --env-file-if-exists=.env app/server.ts",
    "monitor": "node --env-file-if-exists=.env dist/scripts/monitor.js",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@polkadot/api": "16.5.6",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "16.3.0",
    "pino": "10.3.1",
    "rxjs": "7.8.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@ton-community/func-js": "0.11.0",
    "@ton/sandbox": "0.44.0",
    "@ton/tolk-js": "1.4.2",
    "@types/node": "26.5.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/sdk.d.ts",
      "import": "./dist/src/sdk.js"
    },
    "./midnight-provider": {
      "types": "./dist/src/live-midnight.d.ts",
      "import": "./dist/src/live-midnight.js"
    }
  },
  "files": [
    "dist/src",
    "dist/build/midnight/contract",
    "contracts",
    "docs",
    "README.md",
    "LICENSE",
    "dist/scripts",
    "infrastructure",
    "compose.yaml",
    ".env.example",
    "NOTICE",
    "examples/notes/*.mjs",
    "examples/notes/README.md",
    "examples/notes/package.json",
    "examples/notes/env.example",
    "examples/notes/*.html"
  ],
  "license": "Apache-2.0"
}
