# systemd reads only this file, not the repository .env. It holds a provider token:
# install it owner-only (chmod 600).
BRIDGE_NETWORK=preprod
# Midnight preprod is served by Blockfrost; the route check fails without this.
BLOCKFROST_PROJECT_ID=nightpreprod...
# TON_RPC_URL=https://testnet-v4.tonhubapi.com
BRIDGE_STATE_DIR=/var/lib/bridge
BRIDGE_MONITOR_DIR=/var/lib/bridge-monitor
BRIDGE_MONITOR_LOCK_DIR=/run/bridge-monitor
BRIDGE_MONITOR_PORT=9095
BRIDGE_MONITOR_INTERVAL_MS=60000
BRIDGE_MONITOR_TIMEOUT_MS=45000
BRIDGE_MONITOR_FAILURE_THRESHOLD=3
