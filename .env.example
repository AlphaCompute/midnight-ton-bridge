# Copy to .env and chmod 600 (it may hold a provider token). Every npm script loads it.
# Use local or preprod. Mainnet operations are disabled. MIDNIGHT_NETWORK is an accepted
# alias; set at most one, or both to the same value.
BRIDGE_NETWORK=local
# BRIDGE_STATE_DIR=/absolute/private/state-directory
# Endpoint defaults follow BRIDGE_NETWORK. Uncomment only deliberate overrides.
# Midnight preprod is served by Blockfrost (Midnight's hosted endpoints closed 2026-10-09).
# BLOCKFROST_PROJECT_ID=nightpreprod...
# MIDNIGHT_NODE_URL=http://127.0.0.1:19944
# MIDNIGHT_NODE_WS=ws://127.0.0.1:19944
# MIDNIGHT_INDEXER_URL=http://127.0.0.1:18088/api/v3/graphql
# MIDNIGHT_INDEXER_WS=ws://127.0.0.1:18088/api/v3/graphql/ws
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:16300
# MIDNIGHT_SEED_FILE=/absolute/private/midnight-test-wallet.json
# MIDNIGHT_SEED=64-hex  (local network only; public networks require an owner-only seed file)
# MIDNIGHT_COMMITTEE_FILE=/absolute/private/midnight-public-committee.json
# TON_COMMITTEE_FILE=/absolute/private/ton-public-committee.json
# BRIDGE_DOMAIN=32-byte-hex-shared-by-both-deployments
# TON_RPC_URL=https://testnet-v4.tonhubapi.com
# Signed TON messages are also relayed here (comma-separated toncenter sendBoc URLs; empty disables).
# Each endpoint must prove it serves TON testnet before it receives a message.
# TON_BROADCAST_URLS=https://testnet.toncenter.com/api/v2/sendBoc
# ACTON_BINARY=/absolute/path/to/acton
# BRIDGE_ASSETS_FILE=/absolute/path/to/approved-assets.json (example: docs/evidence/testnet-assets.json)
# RECONCILE_WAIT_MS=120000
# Directory for the per-wallet TON send lock shared by every state directory (default: system temp).
# BRIDGE_LOCK_DIR=/run/user/1000
# Monitor (npm run monitor); the systemd template sets these in monitor.env.
# BRIDGE_MONITOR_DIR=.state/monitor
# BRIDGE_MONITOR_PORT=9095
# BRIDGE_MONITOR_INTERVAL_MS=60000
# Web app (npm run app)
# BRIDGE_DEPLOYMENT_FILE=docs/evidence/testnet-deployment.json
# HOST=127.0.0.1
# PORT=3080
# Extra hostnames browsers may use to reach the app (comma-separated), e.g. behind a proxy.
# APP_ALLOWED_HOSTS=bridge.example.internal
